<resources>
    <!-- The panel runs at 60, 90, 120 or 144 Hz, so let the user bound it. -->
    <bool name="config_show_min_refresh_rate_switch">true</bool>
    <bool name="config_show_peak_refresh_rate_switch">true</bool>

    <!-- The vibrator HAL reports AMPLITUDE_CONTROL. -->
    <integer name="config_vibration_supported_intensity_levels">3</integer>

    <!-- The gauge exposes /sys/class/power_supply/battery/cycle_count. -->
    <bool name="config_show_battery_cycle_count">true</bool>
</resources>
