// Minimal stand ins for the MIUI framework classes the stock LPA links against.
java_library {
    name: "miui-framework-stub",
    installable: true,
    sdk_version: "core_platform",
    libs: [
        "framework",
    ],
    srcs: ["java/**/*.java"],
}
