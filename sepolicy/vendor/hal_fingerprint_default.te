allow hal_fingerprint_default fingerprint_device:chr_file { ioctl open read write };
allow hal_fingerprint_default hal_graphics_composer_default:binder { call transfer };
allow hal_fingerprint_default input_device:chr_file { ioctl open read write };
allow hal_fingerprint_default input_device:dir { open read search };
allow hal_fingerprint_default vendor_data_file:dir { add_name write };
allow hal_fingerprint_default vendor_data_file:file { append create getattr open read };
add_service(hal_fingerprint_default, mifxtunnel_service)
typeattribute hal_fingerprint_default hal_mtk_composer_ext_client;
add_service(hal_fingerprint_default, fingerprint_extension_service)
allow hal_fingerprint_default sysfs_display_feature:dir { search };
allow hal_fingerprint_default sysfs_display_feature:file { open read };
allow hal_fingerprint_default sysfs_touch:dir { search };
allow hal_fingerprint_default sysfs_touch:file { open read };
