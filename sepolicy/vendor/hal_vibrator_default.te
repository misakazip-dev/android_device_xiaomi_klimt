allow hal_vibrator_default mnt_vendor_file:dir { search };
allow hal_vibrator_default persist_data_file:dir { search };
allow hal_vibrator_default persist_data_file:file { getattr open read };
allow hal_vibrator_default sysfs_vibrator:file { open read write };
