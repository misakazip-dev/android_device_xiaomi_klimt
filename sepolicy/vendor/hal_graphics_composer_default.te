allow hal_graphics_composer_default hal_displayfeature:binder { call };
allow hal_graphics_composer_default hal_fingerprint_default:binder { call };
allow hal_graphics_composer_default mnt_vendor_file:dir { search };
allow hal_graphics_composer_default persist_data_file:dir { search };
allow hal_graphics_composer_default persist_data_file:file { getattr open read };
allow hal_graphics_composer_default sysfs_display_feature:file { open read write };
add_service(hal_graphics_composer_default, mihwcextension_service)
allow hal_graphics_composer_default citsensorservice_service:service_manager find;
allow hal_graphics_composer_default hal_displayfeature_service:service_manager find;
allow hal_graphics_composer_default sysfs_display_feature:dir { search };
